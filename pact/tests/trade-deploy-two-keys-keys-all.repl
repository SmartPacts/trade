;; DEPLOY FAILS CLOSED — a fresh deploy whose trade-gov is two keys under keys-all: only keys-2 is accepted
;; (a single WebAuthn key under keys-all is a w: principal too, so "two or more
;; keys" cannot be told from the principal; keys-2 needs two different keys to sign, whatever their kind).
;; One refusal per file: a failed load leaves the REPL unusable, so it is the last form.
(load "world.repl")
(env-exec-config [])
(begin-tx "a fresh deploy whose trade-gov is two keys under keys-all")
(env-data { "ns": "n_48867b242317a0216a67f8c7ca26696b5878e0e3", "upgrade": false, "trade-gov": { "keys": ["trade-key" "trade-key-2"], "pred": "keys-all" } })
(env-keys ["admin-key" "trade-key" "trade-key-2"])
(expect-failure "a fresh deploy whose trade-gov is two keys under keys-all" "trade-gov must be a keys-2 keyset: two different keys must sign" (load "../modules/trade.pact"))
