;; Boundary test: green on the contract,
;; red when the line it names is weakened. One boundary per file, its own fresh world.
(load "setup.repl")
(env-exec-config [])
(env-events false)
(begin-tx "an order selling exactly 100 smallest units")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-chain-data { "block-time": (time "2026-10-02T10:00:00Z") })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0" , "caps": [(n_bro.tok2.TRANSFER tn.BOB (tn.esc tn.BOB "e") 1.0) (PLACE (tn.key tn.BOB "e"))] }])
(expect "BOUNDARY: 1.00 TOK2 = exactly 100 units is accepted" "open"
  (at 'status (get-order (create-order "e" tn.BOB (read-keyset "bob-g") n_bro.tok2 1.0 n_bro.tok6 1.0 0.05))))
(commit-tx)
