;; DEPLOY FAILS CLOSED — a fresh deploy whose trade-gov lets any one key govern (keys-any)
;; One refusal per file: a failed load leaves the REPL unusable, so it is the last form.
(load "world.repl")
(env-exec-config [])
(begin-tx "a fresh deploy whose trade-gov lets any one key govern (keys-any)")
(env-data { "ns": "n_48867b242317a0216a67f8c7ca26696b5878e0e3", "upgrade": false, "trade-gov": { "keys": ["trade-key" "trade-key-2" "trade-key-3"], "pred": "keys-any" } })
(env-keys ["admin-key" "trade-key" "trade-key-2"])
(expect-failure "a fresh deploy whose trade-gov lets any one key govern (keys-any)" "trade-gov must be a keys-2 keyset: two different keys must sign" (load "../modules/trade.pact"))
