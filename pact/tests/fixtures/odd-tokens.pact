;; TEST FIXTURES — three tokens that are not coin-compatible in behaviour, used to prove the
;; module refuses them at the right place. Not malicious; they simply do less than they declare.
(namespace "n_bro")

;; credits 99% of what it is asked to transfer (a fee-on-transfer token)
(module short-credit GOV
  (implements fungible-v2)
  (defcap GOV () (enforce false "fixture"))
  (defschema account balance:decimal guard:guard)
  (deftable ledger:{account})
  (defcap TRANSFER:bool (sender:string receiver:string amount:decimal) @managed amount TRANSFER-mgr
    (enforce-guard (at 'guard (read ledger sender))))
  (defun TRANSFER-mgr:decimal (managed:decimal requested:decimal) (- managed requested))
  (defun mint (account:string guard:guard amount:decimal)
    (write ledger account { "balance": amount, "guard": guard }))
  (defun transfer:string (sender:string receiver:string amount:decimal)
    (with-capability (TRANSFER sender receiver amount)
      (update ledger sender { "balance": (- (at 'balance (read ledger sender)) amount) })
      (update ledger receiver { "balance": (+ (at 'balance (read ledger receiver)) (* amount 0.99)) })
      (format "ok" [])))
  (defun transfer-create:string (sender:string receiver:string receiver-guard:guard amount:decimal)
    (with-capability (TRANSFER sender receiver amount)
      (update ledger sender { "balance": (- (at 'balance (read ledger sender)) amount) })
      (with-default-read ledger receiver { "balance": 0.0, "guard": receiver-guard } { "balance" := b }
        (write ledger receiver { "balance": (+ b (* amount 0.99)), "guard": receiver-guard }))
      (format "ok" [])))
  (defun get-balance:decimal (account:string) (at 'balance (read ledger account)))
  (defun details:object{fungible-v2.account-details} (account:string)
    (with-read ledger account { "balance" := b, "guard" := g } { "account": account, "balance": b, "guard": g }))
  (defun precision:integer () 12)
  (defun enforce-unit:bool (amount:decimal) (enforce (= (floor amount 12) amount) "unit"))
  (defun create-account:string (account:string guard:guard)
    (insert ledger account { "balance": 0.0, "guard": guard }) (format "ok" []))
  (defun rotate:string (account:string new-guard:guard) (format "ok" []))
  (defpact transfer-crosschain:string (sender:string receiver:string receiver-guard:guard target-chain:string amount:decimal)
    (step (format "x" []))))
(create-table short-credit.ledger)

;; declares fungible-v2 and moves nothing
(module no-op GOV
  (implements fungible-v2)
  (defcap GOV () (enforce false "fixture"))
  (defcap TRANSFER:bool (sender:string receiver:string amount:decimal) @managed amount TRANSFER-mgr true)
  (defun TRANSFER-mgr:decimal (managed:decimal requested:decimal) managed)
  (defun transfer:string (sender:string receiver:string amount:decimal) (format "noop" []))
  (defun transfer-create:string (sender:string receiver:string receiver-guard:guard amount:decimal) (format "noop" []))
  (defun get-balance:decimal (account:string) 0.0)
  (defun details:object{fungible-v2.account-details} (account:string)
    (enforce false "no accounts here")
    { "account": account, "balance": 0.0, "guard": (create-capability-guard (GOV)) })
  (defun precision:integer () 12)
  (defun enforce-unit:bool (amount:decimal) true)
  (defun create-account:string (account:string guard:guard) (format "ok" []))
  (defun rotate:string (account:string new-guard:guard) (format "ok" []))
  (defpact transfer-crosschain:string (sender:string receiver:string receiver-guard:guard target-chain:string amount:decimal)
    (step (format "x" []))))

;; every fungible-v2 function, no (implements fungible-v2)
(module lookalike GOV
  (defcap GOV () (enforce false "fixture"))
  (defcap TRANSFER:bool (sender:string receiver:string amount:decimal) @managed amount TRANSFER-mgr true)
  (defun TRANSFER-mgr:decimal (managed:decimal requested:decimal) managed)
  (defun transfer:string (sender:string receiver:string amount:decimal) (format "noop" []))
  (defun transfer-create:string (sender:string receiver:string receiver-guard:guard amount:decimal) (format "noop" []))
  (defun get-balance:decimal (account:string) 0.0)
  (defun details:object{fungible-v2.account-details} (account:string)
    { "account": account, "balance": 0.0, "guard": (create-capability-guard (GOV)) })
  (defun precision:integer () 12)
  (defun enforce-unit:bool (amount:decimal) true)
  (defun create-account:string (account:string guard:guard) (format "ok" []))
  (defun rotate:string (account:string new-guard:guard) (format "ok" []))
  (defpact transfer-crosschain:string (sender:string receiver:string receiver-guard:guard target-chain:string amount:decimal)
    (step (format "x" []))))

;; accepts only k: account names (the pre-principal reserved-name policy still live in five tokens)
(module k-only GOV
  (implements fungible-v2)
  (defcap GOV () (enforce false "fixture"))
  (defschema account balance:decimal guard:guard)
  (deftable ledger:{account})
  (defcap TRANSFER:bool (sender:string receiver:string amount:decimal) @managed amount TRANSFER-mgr
    (enforce-guard (at 'guard (read ledger sender))))
  (defun TRANSFER-mgr:decimal (managed:decimal requested:decimal) (- managed requested))
  (defun enforce-k (account:string)
    (enforce (= "k:" (take 2 account)) "Unrecognized reserved protocol"))
  (defun mint (account:string guard:guard amount:decimal)
    (write ledger account { "balance": amount, "guard": guard }))
  (defun transfer:string (sender:string receiver:string amount:decimal)
    (with-capability (TRANSFER sender receiver amount)
      (update ledger sender { "balance": (- (at 'balance (read ledger sender)) amount) })
      (update ledger receiver { "balance": (+ (at 'balance (read ledger receiver)) amount) })
      (format "ok" [])))
  (defun transfer-create:string (sender:string receiver:string receiver-guard:guard amount:decimal)
    (enforce-k receiver)
    (with-capability (TRANSFER sender receiver amount)
      (update ledger sender { "balance": (- (at 'balance (read ledger sender)) amount) })
      (with-default-read ledger receiver { "balance": 0.0, "guard": receiver-guard } { "balance" := b }
        (write ledger receiver { "balance": (+ b amount), "guard": receiver-guard }))
      (format "ok" [])))
  (defun get-balance:decimal (account:string) (at 'balance (read ledger account)))
  (defun details:object{fungible-v2.account-details} (account:string)
    (with-read ledger account { "balance" := b, "guard" := g } { "account": account, "balance": b, "guard": g }))
  (defun precision:integer () 12)
  (defun enforce-unit:bool (amount:decimal) (enforce (= (floor amount 12) amount) "unit"))
  (defun create-account:string (account:string guard:guard)
    (enforce-k account)
    (insert ledger account { "balance": 0.0, "guard": guard }) (format "ok" []))
  (defun rotate:string (account:string new-guard:guard) (format "ok" []))
  (defpact transfer-crosschain:string (sender:string receiver:string receiver-guard:guard target-chain:string amount:decimal)
    (step (format "x" []))))
(create-table k-only.ledger)
