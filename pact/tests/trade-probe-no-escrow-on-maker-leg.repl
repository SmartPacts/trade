;; Catches the taker->maker payment being moved INSIDE with-capability (ESCROW key): trade-callbacks.repl's
;; NO-AUTHORITY-ON-BUY-LEGS sensor trips on the buy token's FEE leg, which runs first, so the maker leg is never
;; sensed. At a 0 rate there is no fee leg: the witness token is called only for the maker leg.
(load "setup.repl")
(env-exec-config [])
(begin-tx "witness token")
(env-keys ["admin-key"])
(load "fixtures/witness-token.pact")
(env-keys [])
(n_bro.witness.mint tn.ALICE (read-keyset "alice-g") 1000.0)
(commit-tx)
(begin-tx "WB sells KDA for witness; the rate is cut to 0")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(coin.TRANSFER tn.BOB (tn.esc tn.BOB "WB") 100.0) (PLACE (tn.key tn.BOB "WB"))] }])
(create-order "WB" tn.BOB (read-keyset "bob-g") coin 100.0 n_bro.witness 10.0 0.05)
(env-sigs [])
(env-keys ["trade-key" "trade-key-2"])
(set-fee-rate 0.0)
(env-keys [])
(commit-tx)
(begin-tx "the buy token asks for ESCROW during the maker leg")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-data { "alice-g": { "keys": ["a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"], "pred": "keys-all" }, "witness-mode": "need-escrow", "witness-key": (tn.key tn.BOB "WB") })
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1", "caps": [(n_bro.witness.TRANSFER tn.ALICE tn.BOB 1.0)] }])
(expect-failure "NO-ESCROW-ON-MAKER-LEG" "require-capability: not granted"
  (fill-order (tn.key tn.BOB "WB") tn.ALICE (read-keyset "alice-g") 10.0 0.05))
(rollback-tx)
(begin-tx "control: the same fill with a plain witness lands, so the refusal above is the sensor")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-data { "alice-g": { "keys": ["a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"], "pred": "keys-all" }, "witness-mode": "plain", "witness-key": "" })
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1", "caps": [(n_bro.witness.TRANSFER tn.ALICE tn.BOB 10.0)] }])
(expect "control: closes at rate 0" [true 0.0 0.0] (let ((q (fill-order (tn.key tn.BOB "WB") tn.ALICE (read-keyset "alice-g") 100.0 0.05))) [(at 'closes q) (at 'maker-fee q) (at 'taker-fee q)]))
(rollback-tx)
