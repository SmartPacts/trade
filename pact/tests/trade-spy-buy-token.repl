;; What a hostile BUY token sees while create-order opens the
;; maker's receiving account — none of our capabilities, and the maker's guard does not pass there.
;; Scenario: what a hostile BUY token sees while ensure-maker-account calls it. spy.details always fails
;; (so create-account runs); spy.create-account records which trade capabilities are in scope and whether
;; the maker's guard passes there, or (mode "reenter") tries to write trade's settings through set-fee-rate.
(load "setup.repl")
(env-exec-config [])
(env-data
  { "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" }
  , "aud": { "keys": ["aud-key"], "pred": "keys-all" } })
(begin-tx "spy token")
(env-keys ["aud-key"])
(define-namespace "aud" (read-keyset "aud") (read-keyset "aud"))
(namespace "aud")
(define-keyset "aud.g" (read-keyset "aud"))
(module spy "aud.g"
  (implements fungible-v2)
  (defschema seen place:bool escrow:bool maker-guard-passes:bool)
  (deftable sightings:{seen})
  (defschema account balance:decimal guard:guard)
  (deftable ledger:{account})
  (defcap TRANSFER:bool (sender:string receiver:string amount:decimal) @managed amount TRANSFER-mgr true)
  (defun TRANSFER-mgr:decimal (managed:decimal requested:decimal) (- managed requested))
  (defun transfer:string (sender:string receiver:string amount:decimal) (format "no" []))
  (defun transfer-create:string (sender:string receiver:string receiver-guard:guard amount:decimal) (format "no" []))
  (defun get-balance:decimal (account:string) 0.0)
  (defun details:object{fungible-v2.account-details} (account:string) (enforce false "spy: details always fails"))
  (defun precision:integer () 12)
  (defun enforce-unit:bool (amount:decimal) true)
  (defun create-account:string (account:string guard:guard)
    (let ((k (read-msg "spy-key")))
      (if (= (read-msg "spy-mode") "reenter")
        (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.set-fee-rate 0.05)
        (write sightings account
          { "place": (try false (require-capability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.PLACE k)))
          , "escrow": (try false (require-capability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.ESCROW k)))
          , "maker-guard-passes": (try false (enforce-guard guard)) }))))
  (defun rotate:string (account:string new-guard:guard) (format "no" []))
  (defun seen-at:object (account:string) (read sightings account))
  (defpact transfer-crosschain:string (sender:string receiver:string receiver-guard:guard target-chain:string amount:decimal)
    (step (format "x" []))))
(create-table sightings)
(create-table ledger)
(commit-tx)

(begin-tx "control: the sensor CAN see PLACE and the maker's guard when they are in scope")
(env-data { "spy-key": (tn.key tn.BOB "S"), "spy-mode": "record" })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"
           , "caps": [(n_bro.bro.TRANSFER tn.BOB (tn.esc tn.BOB "S") 1.0) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.PLACE (tn.key tn.BOB "S"))] }])
(env-data { "spy-key": (tn.key tn.BOB "S"), "spy-mode": "record", "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" } })
;; PLACE reads the order's row, so the control posts an ordinary order under that key first
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.create-order "S" tn.BOB (read-keyset "bob-g") n_bro.bro 1.0 coin 10.0 0.05)
(test-capability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.PLACE (tn.key tn.BOB "S")))
(aud.spy.create-account "control" (read-keyset "bob-g"))
(expect "control sees PLACE and the guard passing" { "place": true, "escrow": false, "maker-guard-passes": true } (aud.spy.seen-at "control"))
(rollback-tx)

(begin-tx "bob's order paid in spy: what spy saw")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-data { "spy-key": (tn.key tn.BOB "S"), "spy-mode": "record", "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" } })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"
           , "caps": [(n_bro.bro.TRANSFER tn.BOB (tn.esc tn.BOB "S") 1.0) (PLACE (tn.key tn.BOB "S"))] }])
(create-order "S" tn.BOB (read-keyset "bob-g") n_bro.bro 1.0 aud.spy 10.0 0.05)
(expect "NO-CAP-IN-SCOPE at ensure-maker-account: no PLACE, no ESCROW, the maker's scoped signature does not pass"
  { "place": false, "escrow": false, "maker-guard-passes": false } (aud.spy.seen-at tn.BOB))
(expect "same at ensure-fee-sink (the existing call of the same shape)"
  { "place": false, "escrow": false, "maker-guard-passes": false } (aud.spy.seen-at tn.SINK))
(rollback-tx)

(begin-tx "control: governance-signed set-fee-rate works outside any token call")
(env-keys ["trade-key" "trade-key-2"])
(expect "works" "fee rate 0.05" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.set-fee-rate 0.05))
(rollback-tx)

(begin-tx "REENTRY: spy.create-account calls trade.set-fee-rate in a tx the governance key also signed (unscoped)")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-data { "spy-key": (tn.key tn.BOB "S"), "spy-mode": "reenter", "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" } })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"
           , "caps": [(n_bro.bro.TRANSFER tn.BOB (tn.esc tn.BOB "S") 1.0) (PLACE (tn.key tn.BOB "S"))] }
           { "key": "trade-key", "caps": [] } { "key": "trade-key-2", "caps": [] }])
(expect-failure "re-entry write refused" "Operation disallowed in read-only or sys-only mode" (create-order "S" tn.BOB (read-keyset "bob-g") n_bro.bro 1.0 aud.spy 10.0 0.05))
(rollback-tx)
