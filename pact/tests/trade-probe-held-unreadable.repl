;; Exercises cancel-order's held fallback (0.0), which no other test reaches, so a changed fallback would go unseen. flaky is an
;; honest ledger whose get-balance throws when the tx data says so (a token that breaks after posting). With the
;; balance unreadable, cancel-order must report 0 held and refuse any positive refund amount as above it.
(load "setup.repl")
(env-exec-config [])
(env-data { "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" }, "aud": { "keys": ["aud-key"], "pred": "keys-all" }, "flaky": false })
(begin-tx "flaky token")
(env-keys ["aud-key"])
(define-namespace "aud" (read-keyset "aud") (read-keyset "aud"))
(namespace "aud")
(define-keyset "aud.g" (read-keyset "aud"))
(module flaky "aud.g"
  (implements fungible-v2)
  (defschema account balance:decimal guard:guard)
  (deftable ledger:{account})
  (defcap TRANSFER:bool (sender:string receiver:string amount:decimal) @managed amount TRANSFER-mgr
    (enforce-guard (at 'guard (read ledger sender))))
  (defun TRANSFER-mgr:decimal (managed:decimal requested:decimal) (enforce (>= managed requested) "TRANSFER exceeded") (- managed requested))
  (defun mint (account:string guard:guard amount:decimal) (write ledger account { "balance": amount, "guard": guard }))
  (defun transfer:string (sender:string receiver:string amount:decimal) (enforce false "unused"))
  (defun transfer-create:string (sender:string receiver:string receiver-guard:guard amount:decimal)
    (with-capability (TRANSFER sender receiver amount)
      (update ledger sender { "balance": (- (at 'balance (read ledger sender)) amount) })
      (with-default-read ledger receiver { "balance": 0.0, "guard": receiver-guard } { "balance" := b, "guard" := g }
        (write ledger receiver { "balance": (+ b amount), "guard": g }))
      "ok"))
  (defun get-balance:decimal (account:string)
    (enforce (not (read-msg "flaky")) "flaky: balance unavailable")
    (at 'balance (read ledger account)))
  (defun details:object{fungible-v2.account-details} (account:string)
    (with-read ledger account { "balance" := b, "guard" := g } { "account": account, "balance": b, "guard": g }))
  (defun precision:integer () 12)
  (defun enforce-unit:bool (amount:decimal) true)
  (defun create-account:string (account:string guard:guard) (insert ledger account { "balance": 0.0, "guard": guard }) "ok")
  (defun rotate:string (account:string new-guard:guard) (enforce false "unused"))
  (defpact transfer-crosschain:string (sender:string receiver:string receiver-guard:guard target-chain:string amount:decimal)
    (step (format "x" []))))
(create-table ledger)
(flaky.mint tn.BOB (read-keyset "bob-g") 10.0)
(commit-tx)
(begin-tx "bob posts 5 flaky for 5 KDA; then the token's balance read breaks")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-keys [])
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(aud.flaky.TRANSFER tn.BOB (tn.esc tn.BOB "F") 5.0) (PLACE (tn.key tn.BOB "F"))] }])
(create-order "F" tn.BOB (read-keyset "bob-g") aud.flaky 5.0 coin 5.0 0.05)
(env-data { "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" }, "flaky": true })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(CANCEL (tn.key tn.BOB "F"))] }])
(expect-failure "HELD-UNREADABLE-IS-ZERO: a positive refund is above the 0 it can read" "Refund exceeds the escrow balance of 0.0" (cancel-order (tn.key tn.BOB "F") 1.0))
(expect "HELD-UNREADABLE-IS-ZERO: cancel with 0 reports 0 left" 0.0 (cancel-order (tn.key tn.BOB "F") 0.0))
(rollback-tx)
