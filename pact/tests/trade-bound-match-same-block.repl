;; Boundary test: green on the contract,
;; red when the line it names is weakened. One boundary per file, its own fresh world.
(load "setup.repl")
(env-exec-config [])
(env-events false)
(begin-tx "two orders in the SAME block (equal created-at)")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-chain-data { "block-time": (time "2026-10-02T10:00:00Z") })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0" , "caps": [(n_bro.tok6.TRANSFER tn.BOB (tn.esc tn.BOB "m") 1.0) (PLACE (tn.key tn.BOB "m"))] }
           { "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1", "caps": [(n_bro.tok2.TRANSFER tn.ALICE (tn.esc tn.ALICE "t") 2.0) (PLACE (tn.key tn.ALICE "t"))] }])
(create-order "m" tn.BOB (read-keyset "bob-g") n_bro.tok6 1.0 n_bro.tok2 2.0 0.05)
(create-order "t" tn.ALICE (read-keyset "alice-g") n_bro.tok2 2.0 n_bro.tok6 1.0 0.05)
(env-sigs [])
(expect "BOUNDARY: same-block orders match (either may be named first)" true (at 'closes (match-orders (tn.key tn.BOB "m") (tn.key tn.ALICE "t"))))
(commit-tx)
