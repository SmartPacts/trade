;; Catches one of the taker's BUY-token legs being moved inside with-capability (ESCROW key).
;; trade-callbacks.repl's NO-AUTHORITY-ON-BUY-LEGS witness aborts on the FIRST buy-token call, so a later leg is never
;; sensed. bspy is an honest ledger that RECORDS, per receiver, whether ESCROW of the order was in scope.
(load "setup.repl")
(env-exec-config [])
(env-data { "alice-g": { "keys": ["a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"], "pred": "keys-all" }, "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" }, "aud": { "keys": ["aud-key"], "pred": "keys-all" }, "spy-key": "" })
(begin-tx "bspy")
(env-keys ["aud-key"])
(define-namespace "aud" (read-keyset "aud") (read-keyset "aud"))
(namespace "aud")
(define-keyset "aud.g" (read-keyset "aud"))
(module bspy "aud.g"
  (implements fungible-v2)
  (defschema seen escrow:bool)
  (deftable sightings:{seen})
  (defschema account balance:decimal guard:guard)
  (deftable ledger:{account})
  (defcap TRANSFER:bool (sender:string receiver:string amount:decimal) @managed amount TRANSFER-mgr
    (enforce-guard (at 'guard (read ledger sender))))
  (defun TRANSFER-mgr:decimal (managed:decimal requested:decimal) (enforce (>= managed requested) "TRANSFER exceeded") (- managed requested))
  (defun mint (account:string guard:guard amount:decimal) (write ledger account { "balance": amount, "guard": guard }))
  (defun transfer:string (sender:string receiver:string amount:decimal) (enforce false "unused"))
  (defun transfer-create:string (sender:string receiver:string receiver-guard:guard amount:decimal)
    (write sightings receiver { "escrow": (try false (require-capability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.ESCROW (read-msg "spy-key")))) })
    (with-capability (TRANSFER sender receiver amount)
      (update ledger sender { "balance": (- (at 'balance (read ledger sender)) amount) })
      (with-default-read ledger receiver { "balance": 0.0, "guard": receiver-guard } { "balance" := b, "guard" := g }
        (write ledger receiver { "balance": (+ b amount), "guard": g }))
      "ok"))
  (defun get-balance:decimal (account:string) (at 'balance (read ledger account)))
  (defun details:object{fungible-v2.account-details} (account:string)
    (with-read ledger account { "balance" := b, "guard" := g } { "account": account, "balance": b, "guard": g }))
  (defun precision:integer () 12)
  (defun enforce-unit:bool (amount:decimal) true)
  (defun create-account:string (account:string guard:guard) (insert ledger account { "balance": 0.0, "guard": guard }) "ok")
  (defun rotate:string (account:string new-guard:guard) (enforce false "unused"))
  (defun seen-at:bool (r:string) (at 'escrow (read sightings r)))
  (defpact transfer-crosschain:string (sender:string receiver:string receiver-guard:guard target-chain:string amount:decimal)
    (step (format "x" []))))
(create-table sightings)
(create-table ledger)
(bspy.mint tn.ALICE (read-keyset "alice-g") 100.0)
(commit-tx)
(begin-tx "bob sells 100 KDA for 10 bspy; alice fills 50 KDA")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-keys [])
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(coin.TRANSFER tn.BOB (tn.esc tn.BOB "S") 100.0) (PLACE (tn.key tn.BOB "S"))] }])
(create-order "S" tn.BOB (read-keyset "bob-g") coin 100.0 aud.bspy 10.0 0.05)
(env-data { "alice-g": { "keys": ["a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"], "pred": "keys-all" }, "spy-key": (tn.key tn.BOB "S") })
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1", "caps": [(aud.bspy.TRANSFER tn.ALICE tn.BOB 4.95) (aud.bspy.TRANSFER tn.ALICE tn.SINK 0.05)] }])
(fill-order (tn.key tn.BOB "S") tn.ALICE (read-keyset "alice-g") 50.0 0.05)
(expect "NO-ESCROW-ON-ANY-BUY-LEG: neither the maker leg nor the fee leg ran with ESCROW in scope" [false false]
  [(aud.bspy.seen-at tn.BOB) (aud.bspy.seen-at tn.SINK)])
(rollback-tx)
