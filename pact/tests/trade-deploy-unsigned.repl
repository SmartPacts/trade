;; DEPLOY FAILS CLOSED — a fresh deploy whose trade-gov keys did not sign
;; One refusal per file: a failed load leaves the REPL unusable, so it is the last form.
(load "world.repl")
(env-exec-config [])
(begin-tx "a fresh deploy whose trade-gov keys did not sign")
(env-data { "ns": "n_48867b242317a0216a67f8c7ca26696b5878e0e3", "upgrade": false, "trade-gov": { "keys": ["trade-key" "trade-key-2" "trade-key-3"], "pred": "keys-2" } })
(env-keys ["admin-key"])
(expect-failure "a fresh deploy whose trade-gov keys did not sign" "Keyset failure" (load "../modules/trade.pact"))
