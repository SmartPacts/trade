(begin-tx "the price of the remainder has drifted")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(expect "maker has received at least the posted ratio for what was taken" true (>= (- 100.0 (at 'buy-remaining (get-order (tn.key tn.BOB "D")))) (- 100.0 (at 'sell-remaining (get-order (tn.key tn.BOB "D"))))))
(expect-failure "EVERY-PARTIAL-FILL-PAYS-A-FEE: a minimum-size fill would now cost under 100 units" "Fill is too small: its cost is below 100 smallest units of the buy token" (quote (tn.key tn.BOB "D") 1.0))
(expect "a larger partial fill is accepted and carries a fee" true (> (at 'maker-fee (quote (tn.key tn.BOB "D") 2.000000)) 0.0))
(expect "the closing fill is accepted" true (at 'closes (quote (tn.key tn.BOB "D") 21.964038)))
(commit-tx)
