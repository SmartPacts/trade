;; Pins that the SELL token's get-balance / details / precision are never called while PLACE is in scope,
;; and its get-balance never while CANCEL is in scope. trade-probe-no-place-during-deposit.repl senses PLACE
;; only in transfer-create; nothing senses the sell token's read functions. rspy is an honest ledger whose read
;; functions refuse to run (or, under try, report a poisoned balance) when PLACE or CANCEL of the order is in scope.
(load "setup.repl")
(env-exec-config [])
(env-data { "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" }, "aud": { "keys": ["aud-key"], "pred": "keys-all" }, "spy-key": "" })
(begin-tx "rspy")
(env-keys ["aud-key"])
(define-namespace "aud" (read-keyset "aud") (read-keyset "aud"))
(namespace "aud")
(define-keyset "aud.g" (read-keyset "aud"))
(module rspy "aud.g"
  (implements fungible-v2)
  (defschema account balance:decimal guard:guard)
  (deftable ledger:{account})
  (defcap TRANSFER:bool (sender:string receiver:string amount:decimal) @managed amount TRANSFER-mgr
    (enforce-guard (at 'guard (read ledger sender))))
  (defun TRANSFER-mgr:decimal (managed:decimal requested:decimal) (enforce (>= managed requested) "TRANSFER exceeded") (- managed requested))
  (defun place-in-scope:bool () (try false (require-capability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.PLACE (read-msg "spy-key")))))
  (defun cancel-in-scope:bool () (try false (require-capability (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.CANCEL (read-msg "spy-key")))))
  (defun clean:bool (fn:string)
    (enforce (not (place-in-scope)) (format "rspy: PLACE in scope during {}" [fn]))
    (enforce (not (cancel-in-scope)) (format "rspy: CANCEL in scope during {}" [fn])))
  (defun mint (account:string guard:guard amount:decimal) (write ledger account { "balance": amount, "guard": guard }))
  (defun transfer:string (sender:string receiver:string amount:decimal) (enforce false "unused"))
  (defun transfer-create:string (sender:string receiver:string receiver-guard:guard amount:decimal)
    (with-capability (TRANSFER sender receiver amount)
      (update ledger sender { "balance": (- (at 'balance (read ledger sender)) amount) })
      (with-default-read ledger receiver { "balance": 0.0, "guard": receiver-guard } { "balance" := b, "guard" := g }
        (write ledger receiver { "balance": (+ b amount), "guard": g }))
      "ok"))
  ;; under try a refusal would be swallowed, so the balance is also poisoned when a scope is visible
  (defun get-balance:decimal (account:string)
    (enforce (not (cancel-in-scope)) "rspy: CANCEL in scope during get-balance")
    (with-default-read ledger account { "balance": 0.0 } { "balance" := b }
      (+ b (if (place-in-scope) 1000.0 0.0))))
  (defun details:object{fungible-v2.account-details} (account:string)
    (clean "details")
    (with-read ledger account { "balance" := b, "guard" := g } { "account": account, "balance": b, "guard": g }))
  (defun precision:integer () (clean "precision") 12)
  (defun enforce-unit:bool (amount:decimal) true)
  (defun create-account:string (account:string guard:guard) (clean "create-account") (insert ledger account { "balance": 0.0, "guard": guard }) "ok")
  (defun rotate:string (account:string new-guard:guard) (enforce false "unused"))
  (defpact transfer-crosschain:string (sender:string receiver:string receiver-guard:guard target-chain:string amount:decimal)
    (step (format "x" []))))
(create-table ledger)
(rspy.mint tn.BOB (read-keyset "bob-g") 10.0)
(commit-tx)
(begin-tx "bob posts and cancels an order selling rspy")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-keys [])
(env-data { "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" }, "spy-key": (tn.key tn.BOB "R") })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(aud.rspy.TRANSFER tn.BOB (tn.esc tn.BOB "R") 5.0) (PLACE (tn.key tn.BOB "R")) (CANCEL (tn.key tn.BOB "R"))] }])
(expect "SELL-TOKEN-READS-OUTSIDE-PLACE: the order posts" (tn.key tn.BOB "R") (create-order "R" tn.BOB (read-keyset "bob-g") aud.rspy 5.0 coin 5.0 0.05))
(expect "SELL-TOKEN-READS-OUTSIDE-CANCEL: the cancel refunds everything" 0.0 (cancel-order (tn.key tn.BOB "R") 5.0))
(expect "bob has his 10 rspy back" 10.0 (aud.rspy.get-balance tn.BOB))
(rollback-tx)
