;; Boundary test: green on the contract,
;; red when the line it names is weakened. One boundary per file, its own fresh world.
(load "setup.repl")
(env-exec-config [])
(env-events false)
(begin-tx "m")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-chain-data { "block-time": (time "2026-10-02T10:00:00Z") })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0" , "caps": [(n_bro.tok6.TRANSFER tn.BOB (tn.esc tn.BOB "m") 2.0) (PLACE (tn.key tn.BOB "m"))] }])
(create-order "m" tn.BOB (read-keyset "bob-g") n_bro.tok6 2.0 n_bro.tok2 2.0 0.05)
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1" , "caps": [(n_bro.tok2.TRANSFER tn.ALICE tn.BOB 1.49) (n_bro.tok2.TRANSFER tn.ALICE tn.SINK 0.01)] }])
(fill-order (tn.key tn.BOB "m") tn.ALICE (read-keyset "alice-g") 1.5 0.05)
(expect "m left: 0.5 TOK6 for 0.50 TOK2" [0.5 0.5] [(at 'sell-remaining (get-order (tn.key tn.BOB "m"))) (at 'buy-remaining (get-order (tn.key tn.BOB "m")))])
(commit-tx)
(begin-tx "t: alice, newer, sells 1.50 TOK2 for exactly 0.5 TOK6 (both close)")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-chain-data { "block-time": (time "2026-10-02T10:05:00Z") })
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1" , "caps": [(n_bro.tok2.TRANSFER tn.ALICE (tn.esc tn.ALICE "t") 1.5) (PLACE (tn.key tn.ALICE "t"))] }])
(create-order "t" tn.ALICE (read-keyset "alice-g") n_bro.tok2 1.5 n_bro.tok6 0.5 0.05)
(env-sigs [])
(expect "BOTH-CLOSE-BELOW-FLOOR: both close; cost 50 units is allowed because the newer order closes" [0.5 0.5 true]
  (let ((q (match-orders (tn.key tn.BOB "m") (tn.key tn.ALICE "t")))) [(at 'amount q) (at 'cost q) (at 'closes q)]))
(expect "both filled" ["filled" "filled"] [(at 'status (get-order (tn.key tn.BOB "m"))) (at 'status (get-order (tn.key tn.ALICE "t")))])
(commit-tx)
