;; The maker check sits in PLACE's body, where signature scope and guard context differ — so makers of
;; every principal kind are placed (or refused) here, not only k: accounts.
;; With the maker check INSIDE PLACE's body, can each principal kind still place?
;; c: (a contract maker), r: (keyset reference), w: (multi-key) — and can a stranger place in a c: maker's name?
(load "setup.repl")
(env-exec-config [])
(begin-tx "a contract maker: bot, whose account is the c: principal of its own BOT capability")
(env-data { "bot-ns": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" } })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [] }])
(define-namespace "n_bot" (read-keyset 'bot-ns) (read-keyset 'bot-ns))
(namespace "n_bot")
(define-keyset "n_bot.ks" (read-keyset 'bot-ns))
(define-keyset "n_bot.maker" (read-keyset 'bot-ns))
(load "fixtures/maker-contract.pact")
(commit-tx)
(begin-tx "fund bot")
(env-data { "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" } })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(n_bro.bro.TRANSFER tn.BOB (n_bot.bot.me) 10.0)] }])
(n_bro.bro.transfer-create tn.BOB (n_bot.bot.me) (n_bot.bot.g) 10.0)
(commit-tx)
(begin-tx "c: maker places through its own capability, nobody signs")
(env-sigs [])
(expect "MAKER-KIND-c: a contract maker places" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.order-key (n_bot.bot.me) "c1") (n_bot.bot.post "c1" 1.0))
(commit-tx)
(begin-tx "stranger tries to place in bot's name")
(env-sigs [{ "key": "e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5e5", "caps": [] }])
(expect-failure "MAKER-KIND-c: stranger refused" "Capability not acquired"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.create-order "c2" (n_bot.bot.me) (n_bot.bot.g) n_bro.bro 1.0 coin 1.0 0.05))
(rollback-tx)
(begin-tx "r: maker (keyset reference n_bot.maker = bob's key) signs PLACE")
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(n_bro.bro.TRANSFER "r:n_bot.maker" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.escrow-account (tn.key "r:n_bot.maker" "r1")) 1.0) (n_bro.bro.TRANSFER tn.BOB "r:n_bot.maker" 1.0) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.PLACE (tn.key "r:n_bot.maker" "r1"))] }])
(n_bro.bro.transfer-create tn.BOB "r:n_bot.maker" (keyset-ref-guard "n_bot.maker") 1.0)
(expect "MAKER-KIND-r: an r: maker places with PLACE signed" (tn.key "r:n_bot.maker" "r1")
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.create-order "r1" "r:n_bot.maker" (keyset-ref-guard "n_bot.maker") n_bro.bro 1.0 coin 1.0 0.05))
(rollback-tx)
(begin-tx "r: maker WITHOUT PLACE (only the deposit) is refused")
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(n_bro.bro.TRANSFER "r:n_bot.maker" (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.escrow-account (tn.key "r:n_bot.maker" "r1")) 1.0)] }])
(expect-failure "MAKER-KIND-r: deposit-only refused" "Keyset failure"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.create-order "r1" "r:n_bot.maker" (keyset-ref-guard "n_bot.maker") n_bro.bro 1.0 coin 1.0 0.05))
(rollback-tx)
(begin-tx "w: maker (alice+bob, keys-all): both sign PLACE")
(env-data { "w": { "keys": ["a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1", "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" }, "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" } })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(n_bro.bro.TRANSFER tn.BOB (create-principal (read-keyset 'w)) 1.0)] }])
(n_bro.bro.transfer-create tn.BOB (create-principal (read-keyset 'w)) (read-keyset 'w) 1.0)
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.PLACE (tn.key (create-principal (read-keyset 'w)) "w1")) (n_bro.bro.TRANSFER (create-principal (read-keyset 'w)) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.escrow-account (tn.key (create-principal (read-keyset 'w)) "w1")) 1.0)]}
           { "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.PLACE (tn.key (create-principal (read-keyset 'w)) "w1")) (n_bro.bro.TRANSFER (create-principal (read-keyset 'w)) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.escrow-account (tn.key (create-principal (read-keyset 'w)) "w1")) 1.0)]}])
(expect "MAKER-KIND-w: a w: maker places with both keys on PLACE" (tn.key (create-principal (read-keyset 'w)) "w1")
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.create-order "w1" (create-principal (read-keyset 'w)) (read-keyset 'w) n_bro.bro 1.0 coin 1.0 0.05))
(rollback-tx)
(begin-tx "w: maker with only one key's PLACE: refused")
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.PLACE (tn.key (create-principal (read-keyset 'w)) "w1"))]}
           { "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1", "caps": [(n_bro.bro.TRANSFER (create-principal (read-keyset 'w)) (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.escrow-account (tn.key (create-principal (read-keyset 'w)) "w1")) 1.0)]}])
(expect-failure "MAKER-KIND-w: one PLACE of two refused" "Keyset failure"
  (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.create-order "w1" (create-principal (read-keyset 'w)) (read-keyset 'w) n_bro.bro 1.0 coin 1.0 0.05))
(rollback-tx)
