;; Catches the newer order's escrow being released while the OLDER order's ESCROW is still in scope:
;; trade-callbacks.repl MATCH-ONE-ESCROW-AT-A-TIME senses only the OLDER order's token. Here the NEWER order
;; sells the witness token and asks for the older order's ESCROW while it runs.
(load "setup.repl")
(env-exec-config [])
(begin-tx "witness token")
(env-keys ["admin-key"])
(load "fixtures/witness-token.pact")
(env-keys [])
(n_bro.witness.mint tn.ALICE (read-keyset "alice-g") 1000.0)
(commit-tx)
(begin-tx "older O (bob: 100 KDA for 10 witness), then newer N (alice: 10 witness for 100 KDA)")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-data { "alice-g": { "keys": ["a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"], "pred": "keys-all" }, "bob-g": { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" }, "witness-mode": "plain", "witness-key": "" })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0", "caps": [(coin.TRANSFER tn.BOB (tn.esc tn.BOB "O") 100.0) (PLACE (tn.key tn.BOB "O"))] }])
(create-order "O" tn.BOB (read-keyset "bob-g") coin 100.0 n_bro.witness 10.0 0.05)
(env-chain-data { "block-time": (time "2026-10-01T00:00:01Z") })
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1", "caps": [(n_bro.witness.TRANSFER tn.ALICE (tn.esc tn.ALICE "N") 10.0) (PLACE (tn.key tn.ALICE "N"))] }])
(create-order "N" tn.ALICE (read-keyset "alice-g") n_bro.witness 10.0 coin 100.0 0.05)
(env-sigs [])
(commit-tx)
(begin-tx "the newer order's token asks for the OLDER order's ESCROW")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-data { "witness-mode": "need-escrow", "witness-key": (tn.key tn.BOB "O") })
(expect-failure "MATCH-NEWER-TOKEN-NEVER-SEES-OLDER-ESCROW" "require-capability: not granted"
  (match-orders (tn.key tn.BOB "O") (tn.key tn.ALICE "N")))
(rollback-tx)
(begin-tx "control: it sees its own order's ESCROW, and the match settles")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-data { "witness-mode": "need-escrow", "witness-key": (tn.key tn.ALICE "N") })
(expect "control" true (at 'closes (match-orders (tn.key tn.BOB "O") (tn.key tn.ALICE "N"))))
(rollback-tx)
