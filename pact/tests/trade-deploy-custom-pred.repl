;; DEPLOY FAILS CLOSED — a fresh deploy whose trade-gov uses a custom predicate
;; One refusal per file: a failed load leaves the REPL unusable, so it is the last form.
(load "world.repl")
(env-exec-config [])
(begin-tx "a fresh deploy whose trade-gov uses a custom predicate")
(env-data { "ns": "n_48867b242317a0216a67f8c7ca26696b5878e0e3", "upgrade": false, "trade-gov": { "keys": ["trade-key" "k2"], "pred": "n_bro.bro.always" } })
(env-keys ["admin-key" "trade-key" "trade-key-2"])
(expect-failure "a fresh deploy whose trade-gov uses a custom predicate" "trade-gov must be a keys-2 keyset: two different keys must sign" (load "../modules/trade.pact"))
