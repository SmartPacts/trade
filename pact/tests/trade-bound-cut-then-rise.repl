;; CUT-THEN-RISE — a taker quoted after a
;; cut, with a re-raise (still under the stored rate) landing before inclusion, is REFUSED by max-rate; R1a is
;; the closing fill whose maker fee rounds to zero — the one shape where max-rate is the only refusal.
(load "setup.repl")
(env-exec-config [])
(env-data
  { "bob-g":   { "keys": ["b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"], "pred": "keys-all" }
  , "alice-g": { "keys": ["a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"], "pred": "keys-all" } })

(begin-tx "R1: bob posts 2.0 tok6 for 1.50 tok2 at 1 % (max-rate 0.01)")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"
           , "caps": [(n_bro.tok6.TRANSFER tn.BOB (tn.esc tn.BOB "R1") 2.0) (PLACE (tn.key tn.BOB "R1"))] }])
(create-order "R1" tn.BOB (read-keyset "bob-g") n_bro.tok6 2.0 n_bro.tok2 1.5 0.01)
(commit-tx)
(begin-tx "R1 prelude: alice takes 1.4 at 1 %")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
           , "caps": [(n_bro.tok2.TRANSFER tn.ALICE tn.BOB 1.04) (n_bro.tok2.TRANSFER tn.ALICE tn.SINK 0.01)] }])
(expect "R1 prelude" [1.05 0.6 0.45] (let ((q (fill-order (tn.key tn.BOB "R1") tn.ALICE (read-keyset "alice-g") 1.4 0.01))) [(at 'cost q) (at 'sell-remaining q) (at 'buy-remaining q)]))
(commit-tx)
(begin-tx "promo 0")
(env-keys ["trade-key" "trade-key-2"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.set-fee-rate 0.0)
(env-keys [])
(commit-tx)
(begin-tx "R1 quote at 0")
(expect "R1 quote: rate 0, taker-net 0.6" [0.0 0.6] (let ((q (n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.quote (tn.key tn.BOB "R1") 0.6))) [(at 'rate q) (at 'taker-net q)]))
(rollback-tx)
(begin-tx "promo ends")
(env-keys ["trade-key" "trade-key-2"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.set-fee-rate 0.01)
(env-keys [])
(commit-tx)
(begin-tx "R1a: the 0 %-signed fill with max-rate 0.0 lands at 1 %: refused")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(print { "R1 BEFORE": [(n_bro.tok6.get-balance tn.ALICE) (n_bro.tok2.get-balance tn.ALICE) (n_bro.tok6.get-balance (tn.esc tn.BOB "R1")) (at 'sell-remaining (get-order (tn.key tn.BOB "R1")))] })
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
           , "caps": [(n_bro.tok2.TRANSFER tn.ALICE tn.BOB 0.45)] }])
(expect-failure "R1a refused" "Fee rate 0.01 is above the 0.0 you accepted" (fill-order (tn.key tn.BOB "R1") tn.ALICE (read-keyset "alice-g") 0.6 0.0))
(rollback-tx)
(begin-tx "R1a after")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(print { "R1 AFTER-ROLLBACK": [(n_bro.tok6.get-balance tn.ALICE) (n_bro.tok2.get-balance tn.ALICE) (n_bro.tok6.get-balance (tn.esc tn.BOB "R1")) (at 'sell-remaining (get-order (tn.key tn.BOB "R1")))] })
(expect "R1a nothing moved" [100001.386 99998.95 0.6 0.6] [(n_bro.tok6.get-balance tn.ALICE) (n_bro.tok2.get-balance tn.ALICE) (n_bro.tok6.get-balance (tn.esc tn.BOB "R1")) (at 'sell-remaining (get-order (tn.key tn.BOB "R1")))])
(rollback-tx)
(begin-tx "R1b: re-quoted at 1 % and re-signed with max-rate 0.01: lands, pays the new quote")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
           , "caps": [(n_bro.tok2.TRANSFER tn.ALICE tn.BOB 0.45)] }])
(expect "R1b" [0.01 0.594] (let ((q (fill-order (tn.key tn.BOB "R1") tn.ALICE (read-keyset "alice-g") 0.6 0.01))) [(at 'rate q) (at 'taker-net q)]))
(rollback-tx)
(begin-tx "R1c LIMIT: a client that passes max-rate = MAX-FEE-RATE (0.05) with the 0 % quote's caps: lands, 0.594 of 0.6")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
           , "caps": [(n_bro.tok2.TRANSFER tn.ALICE tn.BOB 0.45)] }])
(expect "R1c the protection is the max-rate the client passes" [0.01 0.594] (let ((q (fill-order (tn.key tn.BOB "R1") tn.ALICE (read-keyset "alice-g") 0.6 0.05))) [(at 'rate q) (at 'taker-net q)]))
(rollback-tx)

(begin-tx "R2: rate 2 %, bob posts 100 tok18 for 100.00 tok2")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-keys ["trade-key" "trade-key-2"])
(set-fee-rate 0.02)
(env-keys [])
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0"
           , "caps": [(n_bro.tok18.TRANSFER tn.BOB (tn.esc tn.BOB "R2") 100.0) (PLACE (tn.key tn.BOB "R2"))] }])
(create-order "R2" tn.BOB (read-keyset "bob-g") n_bro.tok18 100.0 n_bro.tok2 100.0 0.02)
(commit-tx)
(begin-tx "cut to 1 %")
(env-keys ["trade-key" "trade-key-2"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.set-fee-rate 0.01)
(env-keys [])
(commit-tx)
(begin-tx "rate to 1.99 %")
(env-keys ["trade-key" "trade-key-2"])
(n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade.set-fee-rate 0.0199)
(env-keys [])
(commit-tx)
(begin-tx "R2: the 1 %-quoted partial fill with max-rate 0.01 lands at 1.99 %: refused")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
           , "caps": [(n_bro.tok2.TRANSFER tn.ALICE tn.BOB 0.99) (n_bro.tok2.TRANSFER tn.ALICE tn.SINK 0.01)] }])
(expect-failure "R2 refused" "Fee rate 0.0199 is above the 0.01 you accepted" (fill-order (tn.key tn.BOB "R2") tn.ALICE (read-keyset "alice-g") 1.0 0.01))
(rollback-tx)
