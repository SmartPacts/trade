;; Boundary test: green on the contract,
;; red when the line it names is weakened. One boundary per file, its own fresh world.
(load "setup.repl")
(env-exec-config [])
(env-events false)
(begin-tx "m: bob sells 1.00 TOK2 for 1.0 TOK6")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-chain-data { "block-time": (time "2026-10-02T10:00:00Z") })
(env-sigs [{ "key": "b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0" , "caps": [(n_bro.tok2.TRANSFER tn.BOB (tn.esc tn.BOB "m") 1.0) (PLACE (tn.key tn.BOB "m"))] }])
(create-order "m" tn.BOB (read-keyset "bob-g") n_bro.tok2 1.0 n_bro.tok6 1.0 0.05)
(commit-tx)
(begin-tx "t: alice sells 4.0 TOK6 for 2.00 TOK2")
(use n_48867b242317a0216a67f8c7ca26696b5878e0e3.trade)
(env-chain-data { "block-time": (time "2026-10-02T10:05:00Z") })
(env-sigs [{ "key": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1" , "caps": [(n_bro.tok6.TRANSFER tn.ALICE (tn.esc tn.ALICE "t") 4.0) (PLACE (tn.key tn.ALICE "t"))] }])
(create-order "t" tn.ALICE (read-keyset "alice-g") n_bro.tok6 4.0 n_bro.tok2 2.0 0.05)
(env-sigs [])
(expect "BOUNDARY: amount exactly 100 units of t's buy token, t not closing, matches" [1.0 false]
  (let ((q (match-orders (tn.key tn.BOB "m") (tn.key tn.ALICE "t")))) [(at 'amount q) (= "filled" (at 'status (get-order (tn.key tn.ALICE "t"))))]))
(commit-tx)
